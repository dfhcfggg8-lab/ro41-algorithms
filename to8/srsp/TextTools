using System;
using System.Text;

public static class TextTools
{
    public static int CountWords(string s)
    {
        if (string.IsNullOrEmpty(s))
            return 0;

        int count = 0;
        bool inWord = false;

        for (int i = 0; i < s.Length; i++)
        {
            if (char.IsWhiteSpace(s[i]))
            {
                inWord = false;
            }
            else if (!inWord)
            {
                inWord = true;
                count++;
            }
        }

        return count;
    }

    public static bool IsPalindrome(string s)
    {
        if (string.IsNullOrEmpty(s))
            return true;

        int left = 0;
        int right = s.Length - 1;

        while (left < right)
        {
            while (left < right && char.IsWhiteSpace(s[left])) left++;
            while (left < right && char.IsWhiteSpace(s[right])) right--;

            if (char.ToLowerInvariant(s[left]) != char.ToLowerInvariant(s[right]))
            {
                return false;
            }

            left++;
            right--;
        }

        return true;
    }

    public static string Initials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return string.Empty;

        StringBuilder sb = new StringBuilder();
        bool isNewWord = true;

        for (int i = 0; i < fullName.Length; i++)
        {
            char c = fullName[i];

            if (char.IsWhiteSpace(c))
            {
                isNewWord = true;
            }
            else if (isNewWord)
            {
                if (sb.Length > 0)
                {
                    sb.Append(" ");
                }
                sb.Append(char.ToUpperInvariant(c));
                sb.Append('.');
                isNewWord = false;
            }
        }

        return sb.ToString();
    }

    public static string Repeat(string s, int n)
    {
        if (string.IsNullOrEmpty(s) || n <= 0)
            return string.Empty;

        StringBuilder sb = new StringBuilder(s.Length * n);
        for (int i = 0; i < n; i++)
        {
            sb.Append(s);
        }

        return sb.ToString();
    }
}

class Program
{
    struct TestCase
    {
        public string Input;
        public int ExpectedWords;
        public bool ExpectedPalindrome;
        public string ExpectedInitials;
        public string ExpectedRepeat;
    }

    static void Main()
    {
        // Набор тестов с ожидаемыми значениями для проверки
        TestCase[] tests = new TestCase[]
        {
            new TestCase { Input = "", ExpectedWords = 0, ExpectedPalindrome = true, ExpectedInitials = "", ExpectedRepeat = "" },
            new TestCase { Input = "   ", ExpectedWords = 0, ExpectedPalindrome = true, ExpectedInitials = "", ExpectedRepeat = "" },
            new TestCase { Input = " a  b ", ExpectedWords = 2, ExpectedPalindrome = false, ExpectedInitials = "A. B.", ExpectedRepeat = " a  b " + " a  b " + " a  b " },
            new TestCase { Input = "А роза упала на лапу Азора", ExpectedWords = 6, ExpectedPalindrome = true, ExpectedInitials = "А. Р. У. Н. Л. А.", ExpectedRepeat = "А роза упала на лапу АзораА роза упала на лапу АзораА роза упала на лапу Азора" },
            new TestCase { Input = "Ахметов Ерлан", ExpectedWords = 2, ExpectedPalindrome = false, ExpectedInitials = "А. Е.", ExpectedRepeat = "Ахметов ЕрланАхметов ЕрланАхметов Ерлан" }
        };

        Console.WriteLine($"{"Вход",-30} | {"Метод",-15} | {"Ожидание",-20} | {"Факт",-20} | {"Статус"}");
        Console.WriteLine(new string('-', 100));

        foreach (var t in tests)
        {
            RunCheck(t.Input, "CountWords", t.ExpectedWords.ToString(), TextTools.CountWords(t.Input).ToString());
            RunCheck(t.Input, "IsPalindrome", t.ExpectedPalindrome.ToString(), TextTools.IsPalindrome(t.Input).ToString());
            RunCheck(t.Input, "Initials", t.ExpectedInitials, TextTools.Initials(t.Input));
            RunCheck(t.Input, "Repeat(3)", t.ExpectedRepeat, TextTools.Repeat(t.Input, 3));
            Console.WriteLine(new string('-', 100));
        }
    }

    static void RunCheck(string input, string methodName, string expected, string actual)
    {
        string displayInput = string.IsNullOrEmpty(input) ? "<пусто>" : (input.Trim().Length == 0 ? "<пробелы>" : input);
        bool isOk = expected == actual;
        string status = isOk ? "OK" : "FAIL";

        // Ограничим длину вывода для удобства чтения
        if (displayInput.Length > 25) displayInput = displayInput.Substring(0, 22) + "...";
        if (expected.Length > 18) expected = expected.Substring(0, 15) + "...";
        if (actual.Length > 18) actual = actual.Substring(0, 15) + "...";

        Console.WriteLine($"{displayInput,-30} | {methodName,-15} | {expected,-20} | {actual,-20} | {status}");
    }
}
